{
  "org_name": "CloudSmith-Release-Safety",
  "repo_name": "pet-clinic-cloudwatch",
  "repo_url": "https://github.com/CloudSmith-Release-Safety/pet-clinic-cloudwatch",
  "infrastructure_providers": [
    {
      "provider_id": "aws_cloudwatch_synthetics_canaries",
      "resource_type": "CloudWatch Synthetics Canary",
      "resource_identifier": "arn:aws:synthetics:${region}:${account-id}:canary:*",
      "file_path": "scripts/eks/appsignals/create-canaries.sh",
      "infrastructure_type": "SDK-Direct",
      "description": "CloudWatch Synthetics canaries that simulate user interactions with the pet-clinic application to generate traffic and monitor availability",
      "interfaces": [
        {
          "interface_type": "monitoring",
          "endpoint_pattern": "arn:aws:synthetics:${region}:${account-id}:canary:*",
          "operations": ["RunCanary", "GetCanaryRuns", "GetCanary"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "runtime_version": "syn-nodejs-puppeteer-6.2",
        "schedule": "rate(1 minute)",
        "active_tracing": true,
        "environment_variables": {
          "URL": "http://${ingress_endpoint}"
        }
      },
      "security": {
        "role_name": "CloudWatchSyntheticsRole-PetClinic-${account_id}-${region}",
        "policy_name": "CloudWatchSyntheticsPolicy-PetClinic-${account_id}-${region}"
      },
      "environment_variables": ["URL"],
      "deployment_details": {
        "s3_code_bucket": "aws-synthetics-code-petclinic-${account_id}-${region}",
        "s3_artifact_bucket": "cw-syn-results-petclinic-${account_id}-${region}"
      },
      "provider_type": "internal"
    },
    {
      "provider_id": "aws_cloudwatch_application_signals_slo",
      "resource_type": "CloudWatch Application Signals SLO",
      "resource_identifier": "arn:aws:application-signals:${region}:${account-id}:slo/*",
      "file_path": "scripts/eks/appsignals/create-slo.sh",
      "infrastructure_type": "SDK-Direct",
      "description": "CloudWatch Application Signals Service Level Objectives (SLOs) for monitoring the pet-clinic application's performance and availability",
      "interfaces": [
        {
          "interface_type": "monitoring",
          "endpoint_pattern": "https://application-signals.${region}.api.aws",
          "operations": ["CreateServiceLevelObjective", "GetServiceLevelObjective", "DeleteServiceLevelObjective"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "service_name": "pet-clinic-frontend-java",
        "operations_monitored": ["GET /api/customer/owners", "POST /api/customer/owners"],
        "metrics_monitored": ["AVAILABILITY", "LATENCY"]
      },
      "provider_type": "internal"
    },
    {
      "provider_id": "aws_s3_bucket_canary_code",
      "resource_type": "S3",
      "resource_identifier": "aws-synthetics-code-petclinic-${account_id}-${region}",
      "file_path": "scripts/eks/appsignals/create-canaries.sh",
      "infrastructure_type": "SDK-Direct",
      "description": "S3 bucket that stores the code for CloudWatch Synthetics canaries",
      "interfaces": [
        {
          "interface_type": "storage",
          "endpoint_pattern": "s3://aws-synthetics-code-petclinic-${account_id}-${region}",
          "operations": ["PutObject", "GetObject", "DeleteObject"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "region": "${region}"
      },
      "provider_type": "internal"
    },
    {
      "provider_id": "aws_s3_bucket_canary_results",
      "resource_type": "S3",
      "resource_identifier": "cw-syn-results-petclinic-${account_id}-${region}",
      "file_path": "scripts/eks/appsignals/create-canaries.sh",
      "infrastructure_type": "SDK-Direct",
      "description": "S3 bucket that stores the results from CloudWatch Synthetics canary runs",
      "interfaces": [
        {
          "interface_type": "storage",
          "endpoint_pattern": "s3://cw-syn-results-petclinic-${account_id}-${region}",
          "operations": ["PutObject", "GetObject", "DeleteObject", "GetBucketLocation"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "region": "${region}"
      },
      "provider_type": "internal"
    },
    {
      "provider_id": "aws_iam_role_canary",
      "resource_type": "IAM Role",
      "resource_identifier": "CloudWatchSyntheticsRole-PetClinic-${account_id}-${region}",
      "file_path": "scripts/eks/appsignals/canaries/policies/canary_role.json",
      "infrastructure_type": "SDK-Direct",
      "description": "IAM role that CloudWatch Synthetics canaries assume to execute tests and publish results",
      "interfaces": [
        {
          "interface_type": "authentication",
          "endpoint_pattern": "arn:aws:iam::${account_id}:role/service-role/CloudWatchSyntheticsRole-PetClinic-${account_id}-${region}",
          "operations": ["AssumeRole"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "assume_role_policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      },
      "provider_type": "internal"
    },
    {
      "provider_id": "aws_iam_policy_canary",
      "resource_type": "IAM Policy",
      "resource_identifier": "CloudWatchSyntheticsPolicy-PetClinic-${account_id}-${region}",
      "file_path": "scripts/eks/appsignals/canaries/policies/canary_policy.json",
      "infrastructure_type": "SDK-Direct",
      "description": "IAM policy that grants permissions to CloudWatch Synthetics canaries",
      "interfaces": [
        {
          "interface_type": "authorization",
          "endpoint_pattern": "arn:aws:iam::${account_id}:policy/service-role/CloudWatchSyntheticsPolicy-PetClinic-${account_id}-${region}",
          "operations": ["AttachRolePolicy", "DetachRolePolicy"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "policy_document": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:PutObject",
                "s3:GetObject"
              ],
              "Resource": [
                "arn:aws:s3:::cw-syn-results-petclinic-*-*/*"
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketLocation"
              ],
              "Resource": [
                "arn:aws:s3:::cwn-syn-results-petclinic-*-*"
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "logs:CreateLogGroup"
              ],
              "Resource": [
                "arn:aws:logs:*:*:log-group:/aws/lambda/cwsyn-*"
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:ListAllMyBuckets",
                "xray:PutTraceSegments"
              ],
              "Resource": [
                "*"
              ]
            },
            {
              "Effect": "Allow",
              "Resource": "*",
              "Action": "cloudwatch:PutMetricData",
              "Condition": {
                "StringEquals": {
                  "cloudwatch:namespace": "CloudWatchSynthetics"
                }
              }
            }
          ]
        }
      },
      "provider_type": "internal"
    },
    {
      "provider_id": "aws_cloudwatch_logs_canary",
      "resource_type": "CloudWatch Logs",
      "resource_identifier": "/aws/lambda/cwsyn-*",
      "file_path": "scripts/eks/appsignals/canaries/policies/canary_policy.json",
      "infrastructure_type": "SDK-Direct",
      "description": "CloudWatch Logs groups for storing logs from Synthetics canary executions",
      "interfaces": [
        {
          "interface_type": "logs",
          "endpoint_pattern": "arn:aws:logs:${region}:${account-id}:log-group:/aws/lambda/cwsyn-*",
          "operations": ["CreateLogStream", "PutLogEvents", "CreateLogGroup"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "log_group_pattern": "/aws/lambda/cwsyn-${canary_name}-${canary_id}"
      },
      "provider_type": "internal"
    },
    {
      "provider_id": "aws_eks_cluster",
      "resource_type": "EKS",
      "resource_identifier": "${TF_VAR_cluster_name}",
      "file_path": ".github/workflows/deploy-canaries.yml",
      "infrastructure_type": "External",
      "description": "EKS cluster where the pet-clinic application is deployed",
      "interfaces": [
        {
          "interface_type": "kubernetes",
          "endpoint_pattern": "arn:aws:eks:${region}:${account-id}:cluster/${TF_VAR_cluster_name}",
          "operations": ["DescribeCluster", "ListNodegroups"],
          "authentication": "IAM"
        }
      ],
      "configuration": {
        "region": "${region}",
        "name": "${TF_VAR_cluster_name}"
      },
      "provider_type": "external",
      "external_consumers": ["pet-clinic-application"]
    }
  ],
